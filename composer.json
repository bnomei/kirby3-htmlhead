{
  "name": "bnomei/kirby3-htmlhead",
  "description": "Kirby Plugin for a best-practice HTML Head Element extendable with snippets.",
  "type": "kirby-plugin",
  "version": "6.0.0",
  "license": "MIT",
  "authors": [
    {
      "name": "Bruno Meilick",
      "email": "b@bnomei.com"
    }
  ],
  "keywords": [
    "kirby",
    "kirby-cms",
    "kirby-plugin",
    "html5",
    "head",
    "meta",
    "best-practice",
    "rss-feed",
    "json-feed",
    "accessibility",
    "json-ld",
    "meta-tags",
    "script",
    "async",
    "defert",
    "js",
    "css",
    "preload",
    "prefetch",
    "fluent-builder"
  ],
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true,
    "allow-plugins": {
      "getkirby/composer-installer": true,
      "pestphp/pest-plugin": true
    }
  },
  "autoload": {
    "psr-4": {
      "Bnomei\\": "classes/"
    }
  },
  "require": {
    "php": ">=8.3",
    "getkirby/composer-installer": "^1.2"
  },
  "require-dev": {
    "getkirby/cms": "^6.0",
    "laravel/pint": "^1.13",
    "pestphp/pest": "^v3.5.1",
    "phpstan/phpstan": "^2.1",
    "spatie/ray": "^1.39"
  },
  "scripts": {
    "stan": "./vendor/bin/phpstan",
    "fix": "./vendor/bin/pint",
    "test": "./vendor/bin/pest --profile",
    "panel": [
      "Composer\\Config::disableProcessTimeout",
      "php -S 127.0.0.1:${PORT:-8000} -t tests tests/kirby/router.php"
    ]
  },
  "extra": {
    "kirby-cms-path": "tests/kirby",
    "kirby": {
      "compatible": "^6.0"
    }
  }
}
